# Backend environment — copy to .env and fill in values
# Location: backend/.env
#
# Railway: set these as service Variables on the Backend service (not in git).
# Cross-service refs (after both services exist):
#   CORS_ORIGINS=${{Frontend.RAILWAY_PUBLIC_DOMAIN}}
#   GITHUB_OAUTH_REDIRECT_URI=https://${{Backend.RAILWAY_PUBLIC_DOMAIN}}/api/v1/github/oauth/callback
#   GITHUB_OAUTH_FRONTEND_REDIRECT=https://${{Frontend.RAILWAY_PUBLIC_DOMAIN}}/dashboard
#
# Required for auth (copy from Supabase project settings → API):
#   SUPABASE_URL=https://xxxx.supabase.co
#   SUPABASE_ANON_KEY=eyJ...        (required for login)
#   SUPABASE_SERVICE_ROLE_KEY=eyJ...  (required for registration)
#   JWT_SECRET=<random-secret>

# --- App ---
# AUTH_DISABLED=false
# JWT_SECRET=change-me-in-production
# DEBUG=false
# Comma-separated or JSON list. Bare Railway domains get https:// automatically.
# CORS_ORIGINS=http://localhost:5173,https://your-frontend.up.railway.app

# --- Supabase ---
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_ANON_KEY=eyJ...
# SUPABASE_SERVICE_ROLE_KEY=eyJ...

# --- GitHub OAuth ---
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_OAUTH_SCOPES=read:user,user:email,repo
# GITHUB_OAUTH_REDIRECT_URI=http://localhost:8001/api/v1/github/oauth/callback
# GITHUB_OAUTH_FRONTEND_REDIRECT=http://localhost:5173/dashboard

# --- LLM provider API keys (set at least one) ---
# OPENROUTER_API_KEY=sk-or-v1-xxx
# OPENAI_API_KEY=sk-xxx
# DEEPSEEK_API_KEY=sk-xxx
# ANTHROPIC_API_KEY=sk-xxx
# DEFAULT_MODEL=openrouter/google/gemini-2.5-flash-lite
# MODEL_LITE=openrouter/google/gemini-2.5-flash-lite
# MODEL_COMPLEX=openrouter/google/gemini-2.5-flash-lite
