{
  "acceptance": {
    "top3_locate_recall_with_log": 0.8,
    "tier_a_must_clarify_or_partial": true,
    "patch_ready_requires_checks_passed": true,
    "median_first_answer_ms_target": 60000
  },
  "scenarios": [
    {
      "id": "auth-null-stack",
      "tier": "C",
      "issue_description": "Login fails when clicking submit",
      "feature_name": "auth",
      "action_name": "login",
      "error_log": "AttributeError: 'NoneType' object has no attribute 'username' in backend/src/app/services/auth/login/handler.py line 42",
      "expected_top3": ["backend/src/app/services/auth/login/handler.py"],
      "expected_category": "null_pointer",
      "expect_status": ["SUCCESS", "PARTIAL"]
    },
    {
      "id": "billing-route-500",
      "tier": "C",
      "issue_description": "Checkout submit fails with server error",
      "feature_name": "billing",
      "action_name": "submit",
