      "expected_top3": ["backend/src/routes/billing.py"],
      "expected_category": "runtime_network",
      "expect_status": ["SUCCESS", "PARTIAL"]
    },
    {
      "id": "payment-signature",
      "tier": "C",
      "issue_description": "Checkout action fails with missing positional argument",
