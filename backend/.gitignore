# Backend-local ignores (product root). Root .gitignore still covers the monorepo.

.venv/
venv/
env/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
dist/
build/
.ruff_cache/
.mypy_cache/
.pytest_cache/
.security-tools/

.env
.env.local

*.db
*.sqlite3

workspace/*
!workspace/.gitkeep
knowledge/*
!knowledge/.gitkeep
logs/*
!logs/.gitkeep
temp/*
!temp/.gitkeep
data/*
!data/.gitkeep

.DS_Store
Thumbs.db
