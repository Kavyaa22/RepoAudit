# Frontend environment — copy to .env and fill in values
# Only VITE_* vars are exposed to the browser.
#
# Local dev:
#   VITE_API_BASE_URL=/api/v1   (Vite proxies /api → backend :8001)
#
# Railway — Frontend service:
#   Runtime (proxy target, no /api/v1 suffix):
#     BACKEND_URL=https://repository-audit-production.up.railway.app
#   Build-time:
#     VITE_API_BASE_URL=/api/v1
#     VITE_AUTH_DISABLED=false

VITE_API_BASE_URL=/api/v1
VITE_AUTH_DISABLED=false
